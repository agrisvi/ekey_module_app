# Line endings, pinned rather than left to whoever clones this.
#
# install_blueprints.sh is run on Home Assistant OS. A CRLF shebang there fails with
# "bad interpreter: /bin/bash^M", which is a confusing way to learn that someone
# committed from Windows with core.autocrlf turned off. The rest is listed for the
# same reason: these files are read by Linux tooling, not by an editor on the
# committer's machine.
* text=auto eol=lf

*.sh        text eol=lf
*.mjs       text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.js        text eol=lf

# PowerShell is the one file that genuinely wants CRLF: it is only ever run on Windows.
*.ps1       text eol=crlf
